# Copy to backend/.env and fill in what you have. Every key is optional:
# with none set, the app runs on the offline keyword engine + curated catalog.
# NEVER commit backend/.env (it is in .gitignore).

# Order to try LLM providers in (skips any without a key)
LLM_PROVIDERS=prune,gemini,openrouter

# Prune gateway (Best Use of Prune API). Sign up: https://app.withprune.com/signup?ref=hackathon&event=sharkbyte
# Prune runs in vault-only mode: store your Gemini key in the Prune dashboard
# (Connect -> Providers -> Gemini). The app only sends the Prune key.
PRUNE_API_KEY=
PRUNE_MODEL=gemini-flash-lite-latest
PRUNE_UPSTREAM=gemini        # gemini | openrouter | openai (must be vaulted in Prune)
# PRUNE_BASE_URL=https://api.withprune.com

# Google Gemini direct (Best Use of Gemini API). Key: https://aistudio.google.com/apikey
# gemini-2.5-flash / 2.0-flash are closed to new accounts; flash-latest works.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# OpenRouter: optional last-resort fallback, not required
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash

# Swarms multi-agent roadmap personalization (Best Use of Swarms API). Key: https://cloud.swarms.world/api-keys
SWARMS_API_KEY=
SWARMS_MODEL=gpt-4.1-mini

# Optional: folder of MDC curriculum PDFs to add as chat context (defaults to backend/pdfs)
# PDF_DIRECTORY=C:\path\to\PDF-Info

# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---- TigerData (Best Use of Tiger Data). Leave empty to use local SQLite. ----
# Copy the "Service URL" from console.cloud.timescale.com; keep ?sslmode=require
DATABASE_URL=

# ---- Auth0 (Best Use of Auth0). Leave empty for demo mode (X-Demo-User header). ----
AUTH0_DOMAIN=            # e.g. dev-abc123.us.auth0.com
AUTH0_AUDIENCE=          # the API Identifier, e.g. https://api.nextstop
AUTH0_CLIENT_ID=         # the SPA's Client ID (public; the website reads it from /api/config)
# AUTH_DEMO_MODE=off     # set off in production

# ---- Deployment ----
# CORS_ORIGINS=https://yourdomain.xyz,https://www.yourdomain.xyz   (also add the classmate's deployed frontend)
# RATE_LIMIT_PER_MIN=40
